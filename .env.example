# ─────────────────────────────────────────────────────────────────────────────
# Salinan berkas ini menjadi `.env` (JANGAN commit `.env`-nya).
#
#   cp .env.example .env      # lalu isi nilainya
#
# Nilai-nilai ini berasal dari dashboard Supabase → Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# Alamat project Supabase, contoh: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (anon / publishable). Aman dipakai di browser karena dibatasi RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci rahasia (service role / secret). MENEMBUS RLS — hanya untuk server.
# Jangan pernah ditulis di NEXT_PUBLIC_*, jangan pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Kunci internal aplikasi
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token untuk endpoint tulis API (POST/PUT/PATCH/DELETE).
# Buat yang panjang dan acak, contoh: openssl rand -hex 24
API_SECRET_KEY=

# Kata sandi untuk masuk ke halaman /admin.
# Ini satu-satunya kunci panel admin. Ganti kalau ada panitia yang keluar.
ADMIN_PASSWORD=

# Opsional. Kalau diisi, sesi admin ditandatangani dengan kunci ini alih-alih
# diturunkan dari ADMIN_PASSWORD + API_SECRET_KEY. Mengganti nilainya
# otomatis memaksa semua sesi lama login ulang.
# ADMIN_SESSION_SECRET=

# Opsional. Nama bucket Supabase Storage untuk gambar. Default: images
# SUPABASE_STORAGE_BUCKET=

# Opsional. Alamat publik situs, dipakai sitemap.xml & robots.txt.
# Kalau kosong, dipakai https://dscmulia.id
# NEXT_PUBLIC_SITE_URL=
